# ==============================================================================
# .gitignore for Academic Claude Code Projects
# ==============================================================================

# LaTeX build artifacts
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.log
*.nav
*.out
*.snm
*.toc
*.vrb
*.synctex.gz
*.run.xml
*-blx.bib

# Compiled PDFs (uncomment to track specific PDFs)
# *.pdf

# Python
__pycache__/
*.pyc
*.pyo

# R
.Rproj.user/
.Rhistory
.RData
.Rdata

# OS files
.DS_Store
Thumbs.db

# Claude Code local files (not shared across machines)
.claude/settings.local.json
.claude/state/
CLAUDE.local.md

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Quarto rendering artifacts
.quarto/

# Output artifacts — uncomment lines below based on your preference
# *.rds
# output/**/*.rds

# Kinship replication data (Zenodo download, ~716 MB)
data_kinship/

# Cached parquet / agent tool outputs
agent-tools/
*.parquet

# IPUMS NHIS extract (588 MB fixed-width, redownload from IPUMS)
nhis_00002.dat

# Local-only reference docs and PDFs
Papers/
*.docx

